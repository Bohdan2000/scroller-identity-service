PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_service

# Secrets — must be at least 32 characters in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters

# Access token lifetime (passport-jwt format: 60, "2 days", "10h", "7d")
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRES_IN_MS=604800000

# OAuth — Google
GOOGLE_CLIENT_ID=

# OAuth — Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Password hashing rounds (10-12 recommended for production)
BCRYPT_ROUNDS=12

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
